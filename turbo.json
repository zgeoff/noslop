{
  "$schema": "./node_modules/turbo/schema.json",
  // turbo otherwise writes a guidance block into the generated AGENTS.md
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      // a package typechecks against its dependencies' source, which its own hash leaves out
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": { "allow": ["module", "adapter", "lib"] }
      },
      // a module never imports an adapter; the app passes each adapter in
      "module": {
        "dependencies": { "allow": ["module", "lib"] }
      },
      // webhook's tests share the stand-in GitHub server that the github adapter exports
      "adapter": {
        "dependencies": { "allow": ["module", "lib", "stand-in"] }
      },
      "stand-in": {},
      "lib": {
        "dependencies": { "allow": ["lib"] }
      }
    }
  }
}
