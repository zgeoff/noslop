{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/strictest/tsconfig.json",
  "files": ["./modules/lenses/src/prompt-pages.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun", "@zgeoff/bun-test-extended"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    // @mswjs/interceptors ships its fetch/web interceptor only in its browser build, whose
    // Interceptor class TypeScript holds apart from the node build's for its #private field
    "paths": {
      "@mswjs/interceptors": [
        "./libs/testing/node_modules/@mswjs/interceptors/lib/browser/index.d.ts"
      ]
    }
  }
}
