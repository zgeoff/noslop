{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim
  "ignore": [".claude/**"],
  // the Bun plugin takes its test files from a `bun test` script, and rig runs the tests
  "bun": { "entry": ["**/*.test.{ts,tsx}"] },
  // the shared oxlint config loads the plugin, the synced start-up stub in .claude/ imports the
  // package, and the chex baseline in node_modules runs diet, so knip sees none of them
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/agent-hooks", "@zgeoff/diet"],
  "workspaces": {
    // rig loads its config by name, and `bun verify up` runs the launch process by its path
    ".": { "entry": ["rig.config.ts", "scripts/verify/run-sandbox-host.ts"] },
    // a stub CLI runs this script by its path
    "libs/testing": { "entry": ["src/stubs/run-stub-cli.ts"] }
  }
}
