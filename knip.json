{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim
  "ignore": [".claude/**"],
  // the Bun plugin takes its test files from a `bun test` script, and rig runs the tests
  "bun": { "entry": ["**/*.test.{ts,tsx}"] },
  // the shared oxlint config loads the plugin, and the synced start-up stub in .claude/ imports
  // the package, so knip sees neither
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/agent-hooks"],
  // repo-sync delivers these scripts from zgeoff/tools and overwrites a local edit, and they export
  // types that only their own file uses
  "ignoreIssues": {
    "scripts/parse-shell-words.ts": ["types"],
    "scripts/shell-escape-parsers.ts": ["types"]
  },
  "workspaces": {
    // rig loads its config by name; repo-sync delivers the related-tests runner with the pre-push
    // baseline, and no script runs it while test:related runs rig
    ".": { "entry": ["rig.config.ts", "scripts/run-related-tests.ts"] },
    // the App server runs the noslop bin of @noslop/cli by its path, which knip cannot see
    "apps/github-app": { "ignoreDependencies": ["@noslop/cli"] }
  }
}
