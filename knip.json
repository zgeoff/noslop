{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim
  "ignore": [".claude/**"],
  // the Bun plugin takes its test files from a `bun test` script, and rig runs the tests
  "bun": { "entry": ["**/*.test.{ts,tsx}"] },
  // the shared oxlint config loads the plugin, and the synced skill-gate hook in .claude/ imports
  // the package, so knip sees neither; the chex baseline in node_modules runs diet
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/skill-gate", "@zgeoff/diet"],
  "workspaces": {
    // rig loads its config by name
    ".": { "entry": ["rig.config.ts"] },
    // the App server runs the noslop bin of @noslop/cli by its path, which knip cannot see
    "apps/github-app": { "ignoreDependencies": ["@noslop/cli"] }
  }
}
