{
  "name": "noslop",
  "version": "0.4.29",
  "private": true,
  "description": "A reviewer for pull requests that coding agents write",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/noslop.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "adapters/*",
      "libs/*"
    ],
    "catalog": {
      "@faker-js/faker": "10.6.0",
      "@logtape/logtape": "2.4.2",
      "@msw/data": "1.1.8",
      "@mswjs/interceptors": "0.45.10",
      "@octokit/app": "16.1.4",
      "@octokit/core": "7.0.8",
      "@octokit/types": "18.0.0",
      "@octokit/webhooks": "14.2.0",
      "elysia": "1.4.30",
      "gunshi": "1.0.0-rc.1",
      "kysely": "0.29.7",
      "msw": "3.0.3",
      "oxc-parser": "0.156.0",
      "ts-pattern": "5.9.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run prose && bun run test && bun run check:package-types",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --quiet .; }",
    "format:check": "oxfmt --check . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --check --quiet .; }",
    "lint": "oxlint",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --report-unused-disable-directives-severity error",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "chex prose AGENTS.md",
    "test": "rig unit",
    "test:model-api": "rig model-api",
    "typecheck": "tsrs --noEmit && turbo run typecheck",
    "test:related": "rig related",
    "build:cli": "bun scripts/write-cli-package.ts",
    "schema:config": "bun scripts/write-config-schema.ts",
    "ci:pick-release-ship": "bun scripts/release/run-pick-release-ship-step.ts",
    "ci:publish-cli": "bun scripts/release/run-publish-cli-step.ts apps/cli/dist",
    "check:docs": "chex prose length links readmes skill",
    "check:package-types": "bun scripts/run-package-types-check.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@maschwenk/tsrslint": "0.1.6",
    "@noslop/contract": "workspace:*",
    "@noslop/testing": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@zgeoff/agent-hooks": "0.2.9",
    "@zgeoff/bun-test-extended": "0.2.3",
    "@zgeoff/chex": "0.2.4",
    "@zgeoff/diet": "0.2.2",
    "@zgeoff/format-codemod": "0.3.5",
    "@zgeoff/oxlint-config": "0.8.6",
    "@zgeoff/rig": "0.2.1",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "msw": "catalog:",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsdown": "0.23.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "zod": "catalog:"
  },
  "overrides": {
    "rolldown-plugin-dts": "0.28.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
