{
  "name": "noslop",
  "version": "0.4.24",
  "private": true,
  "description": "A reviewer for pull requests that coding agents write",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/noslop.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "adapters/*",
      "libs/*"
    ],
    "catalog": {
      "@faker-js/faker": "10.6.0",
      "@logtape/logtape": "2.4.2",
      "@msw/data": "1.1.8",
      "@octokit/app": "16.1.4",
      "@octokit/core": "7.0.8",
      "@octokit/types": "18.0.0",
      "@octokit/webhooks": "14.2.0",
      "elysia": "1.4.30",
      "gunshi": "1.0.0-rc.1",
      "kysely": "0.29.7",
      "msw": "2.15.0",
      "oxc-parser": "0.155.0",
      "ts-pattern": "5.9.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run prose && bun run test",
    "deadcode": "knip",
    "format": "oxfmt . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --quiet .; }",
    "format:check": "oxfmt --check . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --check --quiet .; }",
    "lint": "oxlint",
    "lint:full": "oxlint --type-aware --report-unused-disable-directives-severity error",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "test -f .claude/skills/docs-writing/scripts/check-prose.sh || { echo 'prose: skipped until repo-sync delivers the docs-writing skill'; exit 0; }; bash .claude/skills/docs-writing/scripts/check-length.sh --package README.md && bash .claude/skills/docs-writing/scripts/check-prose.sh AGENTS.md",
    "test": "bun test --randomize --pass-with-no-tests --path-ignore-patterns='**/*.model-api.test.ts'",
    "test:model-api": "bun test --parallel=1 .model-api.test.ts",
    "typecheck": "tsrs --noEmit && turbo run typecheck",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "test:related": "bun scripts/run-related-tests.ts",
    "build:cli": "bun scripts/write-cli-package.ts",
    "schema:config": "bun scripts/write-config-schema.ts",
    "check:commits": "bun scripts/run-commits-check.ts",
    "check:local-paths": "bun scripts/run-local-paths-check.ts",
    "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
    "check:workflows": "bun scripts/run-workflows-check.ts",
    "ci:pick-release-ship": "bun scripts/release/run-pick-release-ship-step.ts",
    "ci:publish-cli": "bun scripts/release/run-publish-cli-step.ts apps/cli/dist",
    "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@noslop/contract": "workspace:*",
    "@noslop/runner": "workspace:*",
    "@noslop/testing": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@zgeoff/bun-test-extended": "0.2.1",
    "@zgeoff/format-codemod": "0.1.0",
    "@zgeoff/oxlint-config": "0.7.0",
    "@zgeoff/skill-gate": "0.2.9",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "msw": "catalog:",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
