{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [".claude/**", ".reviews/**", ".worktrees/**"],
  "rules": {
    // oxlint 1.86 enables one-var through the style category, which the shared config predates; it
    // forbids the separate const per step that every test body uses
    "one-var": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:module",
            "importNames": ["createRequire"],
            "message": "A require function escapes no-restricted-imports; use import."
          },
          {
            "name": "module",
            "importNames": ["createRequire"],
            "message": "A require function escapes no-restricted-imports; use import."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "require",
        "message": "A require function escapes no-restricted-imports; use import."
      }
    ],
    "import/no-commonjs": "error"
  },
  // the App server stands where an org's own relay stands, so it builds only on what @noslop/cli
  // publishes; its tests also reach the stand-ins of @noslop/testing
  "overrides": [
    {
      "files": ["apps/github-app/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@noslop/*", "!@noslop/cli", "!@noslop/cli/*"],
                "message": "The App builds only on @noslop/cli and its subpath exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/github-app/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@noslop/*", "!@noslop/cli", "!@noslop/cli/*", "!@noslop/testing"],
                "message": "The App's tests build only on @noslop/cli and the stand-ins of @noslop/testing."
              }
            ]
          }
        ]
      }
    },
    // repo-sync delivers these scripts from zgeoff/tools and overwrites a local edit, so their verbs
    // are fixed at that source
    {
      "files": ["scripts/read-branch-files.ts", "scripts/run-related-tests.ts"],
      "rules": {
        "zgeoff/verb-contract": "off"
      }
    }
  ]
}
